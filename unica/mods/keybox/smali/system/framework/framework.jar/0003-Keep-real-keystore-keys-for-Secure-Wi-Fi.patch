From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kusti420 <kristjan0@live.com>
Date: Tue, 13 Oct 2026 07:30:00 +0300
Subject: [PATCH] Keep real keystore keys for Secure Wi-Fi

Secure Wi-Fi (com.samsung.android.fast) generates its own RSA key through
AndroidKeyStore and then asks keystore2 (ISamsungAttestation.attestKey) for a
SAK attestation of that alias. With a keybox enabled the imitation layer keeps
the key in the app's unica_keystore.db, so keystore2 answers KEY_NOT_FOUND and
the app shows "This phone doesn't support Secure Wi-Fi". Make the imitation
layer inert in that process.

---
 smali_classes6/io/mesalabs/unica/KeyProviderManager.smali | 17 ++++++++++++++++-
 1 file changed, 16 insertions(+), 1 deletion(-)

diff --git a/smali_classes6/io/mesalabs/unica/KeyProviderManager.smali b/smali_classes6/io/mesalabs/unica/KeyProviderManager.smali
index d68a6e7..77bd019 100644
--- a/smali_classes6/io/mesalabs/unica/KeyProviderManager.smali
+++ b/smali_classes6/io/mesalabs/unica/KeyProviderManager.smali
@@ -85,7 +85,7 @@
 .end method
 
 .method public static blacklist isKeyboxAvailable()Z
-    .locals 2
+    .locals 3
 
     const-string v0, "persist.sys.unica.keybox"
 
@@ -100,6 +100,21 @@
     return v1
 
     :cond_0
+    invoke-static {}, Landroid/app/ActivityThread;->currentPackageName()Ljava/lang/String;
+
+    move-result-object v2
+
+    const-string v0, "com.samsung.android.fast"
+
+    invoke-virtual {v0, v2}, Ljava/lang/String;->equals(Ljava/lang/Object;)Z
+
+    move-result v0
+
+    if-eqz v0, :cond_1
+
+    return v1
+
+    :cond_1
     invoke-static {}, Lio/mesalabs/unica/KeyProviderManager;->getProvider()Lio/mesalabs/unica/IKeyboxProvider;
 
     move-result-object v0
-- 
