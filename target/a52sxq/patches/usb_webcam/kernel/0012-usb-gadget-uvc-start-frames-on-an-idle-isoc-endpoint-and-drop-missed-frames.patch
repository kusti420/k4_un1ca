@@ -262,8 +537,9 @@
 {
 	unsigned int i;
 
-	for (i = 0; i < UVC_NUM_REQUESTS; ++i) {
+	for (i = 0; i < UVC_MAX_NUM_REQUESTS; ++i) {
 		if (video->req[i]) {
+			kfree(video->req[i]->context);
 			usb_ep_free_request(video->ep, video->req[i]);
 			video->req[i] = NULL;
 		}
@@ -292,7 +568,9 @@
 		 * max_t(unsigned int, video->ep->maxburst, 1)
 		 * (video->ep->mult);
 
-	for (i = 0; i < UVC_NUM_REQUESTS; ++i) {
+	for (i = 0; i < video->num_requests; ++i) {
