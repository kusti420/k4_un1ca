 }
 
+/* Give a request back to req_free, or free it if the stream was disabled. */
+static void
+uvc_video_put_request(struct uvc_video *video, struct usb_request *req)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&video->req_lock, flags);
+	/*
+	 * The video stream might have been disabled while we were processing
+	 * the current usb_request, so make sure we're still streaming before
+	 * putting it back on req_free.
+	 */
+	if (video->is_enabled)
+		list_add_tail(&req->list, &video->req_free);
+	else
+		uvc_video_free_request(req, video->ep);
+	spin_unlock_irqrestore(&video->req_lock, flags);
+}
+
+/*
+ * Isochronous scheduling
+ *
+ * dwc3 schedules the requests of an isochronous transfer on consecutive
+ * (micro)frame intervals. A request appended after the controller ran out of
+ * requests is late: its interval has passed, it completes with -EXDEV (since
+ * 0011, as successful before) and its payload is never sent. The requests
+ * appended after it are late as well until the driver catches up, so a frame
+ * loses its tail (truncated frame) or payloads in the middle (corrupted frame
+ * that still has its EOF), and the host can't tell either from a good frame.
+ *
+ * The 5.4 driver started each frame on whatever transfer was running and kept
+ * 4 requests (500 us at 3 KiB per microframe) queued, refilled one per
+ * completion, i.e. it relied on every completion being handled within 500 us.
+ * Now:
+ * - a frame is only started on an idle endpoint (the controller owns no
+ *   request and dwc3 has ended the transfer). uvcg_video_pump() then queues
+ *   all of it, up to num_requests payloads, in one go with the irqlock held;
+ *   dwc3 starts the new transfer 16 microframes after the first request was
+ *   queued, long after the last one was appended;
+ * - the completion handler only refills to continue a frame larger than the
+ *   request pool, with up to num_requests - 1 requests still queued ahead;
+ * - when the controller owns no request any more, uvc_video_idle_work()
+ *   marks the endpoint idle and starts the next frame, if one is queued.
+ *
+ * Missed intervals
+ *
+ * Should a payload still be missed, the frame is dropped (upstream does the
+ * same since 2a3b7af12047 "usb: gadget: uvc: mark incomplete frames with
+ * UVC_STREAM_ERR"). On the first missed request:
+ * - the frame being encoded is not continued: its V4L2 buffer is returned
+ *   with an error and nothing more is queued on the late transfer;
+ * - once the controller owns no request any more, uvc_video_idle_work()
+ *   closes the damaged frame on the host side with a header-only payload
+ *   carrying its FID and the UVC_STREAM_ERR and UVC_STREAM_EOF bits, so that
+ *   the host completes it as erroneous and drops it, then streaming resumes
+ *   with the next buffer and the next FID on a new transfer.
+ * If the missed payload was the first one of its frame, the host has nothing
+ * of that frame and the error payload is not needed; the next frame then
+ * reuses the FID. If the error payload itself is missed, the same happens
+ * again with the same FID: the frame stays open on the host until an error
+ * payload got through.
+ *
+ * Called with video->queue.irqlock held.
+ */
+static void uvc_video_missed(struct uvc_video *video, struct usb_request *req)
+{
+	struct uvc_request *ureq = req->context;
+	struct uvc_video_queue *queue = &video->queue;
+	struct uvc_buffer *buf;
+	u8 fid;
+
+	if (video->recover || video->max_payload_size || req->length < 2)
+		return;
+
+	fid = ((u8 *)req->buf)[1] & UVC_STREAM_FID;
+
+	video->recover = true;
+	video->recover_fid = fid;
+	video->recover_err = !ureq->first;
+	video->stat_dropped++;
+
+	if (queue->buf_used && !list_empty(&queue->irqqueue)) {
+		buf = list_first_entry(&queue->irqqueue, struct uvc_buffer,
+				       queue);
+		list_del(&buf->queue);
+		buf->state = UVC_BUF_STATE_ERROR;
+		vb2_buffer_done(&buf->buf.vb2_buf, VB2_BUF_STATE_ERROR);
+		queue->buf_used = 0;
+		/* The frame after the damaged one was already started. */
+		if ((video->fid & UVC_STREAM_FID) != fid)
+			video->stat_dropped++;
+	}
+
+	if (video->stat_dropped <= 2)
+		uvcg_info(&video->uvc->func,
+			  "missed isochronous transfer, dropping frame\n");
+}
+
+/*
+ * Fill and queue requests, called with video->queue.irqlock held.
+ *
+ * @burst: the endpoint is idle, so frames may be started. Otherwise only a
+ * frame that is already being sent is continued.
+ *
+ * Returns true if queueing failed and the video queue must be cancelled
+ * (after releasing the irqlock).
+ */
+static bool __uvcg_video_pump(struct uvc_video *video, bool burst)
+{
+	struct uvc_video_queue *queue = &video->queue;
+	bool isoc = !video->max_payload_size;
+	struct usb_request *req;
+	struct uvc_buffer *buf;
+
+	/* Nothing to do if the streaming endpoint is not enabled. */
+	while (video->ep->enabled && !video->recover) {
+		buf = uvcg_queue_head(queue);
+		if (buf == NULL)
+			break;
+
+		/* Never start a frame on a running isochronous transfer. */
+		if (isoc && !burst && queue->buf_used == 0)
+			break;
+
+		spin_lock(&video->req_lock);
+		if (!video->is_enabled || list_empty(&video->req_free)) {
+			spin_unlock(&video->req_lock);
+			break;
+		}
+		req = list_first_entry(&video->req_free, struct usb_request,
+					list);
+		list_del(&req->list);
+		spin_unlock(&video->req_lock);
+
+		video->encode(req, video, buf);
+
+		/* Queue the USB request; the endpoint then owns it. */
+		if (uvcg_video_ep_queue(video, req) < 0) {
+			spin_lock(&video->req_lock);
+			if (video->is_enabled)
+				list_add_tail(&req->list, &video->req_free);
+			else
+				uvc_video_free_request(req, video->ep);
+			spin_unlock(&video->req_lock);
+			if (!video->in_flight)
+				video->ep_idle = true;
+			return true;
+		}
+		video->ep_idle = false;
+	}
+
+	return false;
+}
+
+static void uvc_video_idle_work(struct work_struct *work)
+{
+	struct uvc_video *video = container_of(work, struct uvc_video,
+					       idle_work);
+	struct uvc_video_queue *queue = &video->queue;
+	struct usb_request *req = NULL;
+	unsigned long flags;
+	bool cancel;
+	u8 *data;
+
+	/*
+	 * The completion handler gave back the last request the controller
+	 * owned; dwc3 ends the isochronous transfer as soon as that handler
+	 * returns, and starts a new one for the next request queued.
+	 */
+	usleep_range(500, 1000);
+
+	spin_lock_irqsave(&queue->irqlock, flags);
+	if (video->in_flight) {
+		/* Its completion queues this work again. */
+		spin_unlock_irqrestore(&queue->irqlock, flags);
+		return;
+	}
+	video->ep_idle = true;
+
+	if (video->recover && video->recover_err) {
+		spin_lock(&video->req_lock);
+		if (video->is_enabled && !list_empty(&video->req_free)) {
+			req = list_first_entry(&video->req_free,
+					       struct usb_request, list);
+			list_del(&req->list);
+		}
+		spin_unlock(&video->req_lock);
+		if (!req) {
+			/* The stream is being disabled. */
+			spin_unlock_irqrestore(&queue->irqlock, flags);
+			return;
+		}
+
+		((struct uvc_request *)req->context)->first = false;
+		data = req->buf;
+		data[0] = 2;
+		data[1] = UVC_STREAM_EOH | UVC_STREAM_ERR | UVC_STREAM_EOF |
+			  video->recover_fid;
+		req->length = 2;
+
+		if (uvcg_video_ep_queue(video, req) < 0) {
+			/* Endpoint disabled: the stream is being stopped. */
+			spin_unlock_irqrestore(&queue->irqlock, flags);
+			uvc_video_put_request(video, req);
+			return;
+		}
+		video->ep_idle = false;
+		video->stat_markers++;
+		video->fid = video->recover_fid ^ UVC_STREAM_FID;
+		video->recover = false;
+	} else if (video->recover) {
+		video->fid = video->recover_fid;
+		video->recover = false;
+	}
+
+	/* Same transfer as the error payload, if any. */
+	cancel = __uvcg_video_pump(video, true);
+	spin_unlock_irqrestore(&queue->irqlock, flags);
+
+	if (cancel)
+		uvcg_queue_cancel(queue, 0);
+}
+
 /*
  * I somehow feel that synchronisation won't be easy to achieve here. We have
  * three events that control USB requests submission:
@@ -189,10 +445,12 @@
 static void
 uvc_video_complete(struct usb_ep *ep, struct usb_request *req)
 {
-	struct uvc_video *video = req->context;
+	struct uvc_request *ureq = req->context;
+	struct uvc_video *video = ureq->video;
 	struct uvc_video_queue *queue = &video->queue;
 	struct uvc_buffer *buf;
 	unsigned long flags;
+	bool idle = false;
 	int ret;
 
 	spin_lock_irqsave(&video->req_lock, flags);
@@ -207,16 +465,36 @@
 	}
 	spin_unlock_irqrestore(&video->req_lock, flags);
 
+	spin_lock_irqsave(&queue->irqlock, flags);
+	if (video->in_flight)
+		video->in_flight--;
+
 	switch (req->status) {
 	case 0:
 		break;
 
+	case -EXDEV:	/* missed isochronous interval, nothing was sent */
+		uvcg_dbg(&video->uvc->func, "VS request missed xfer.\n");
+		if (req->length == 0)
+			break;
+		video->stat_missed++;
+		if (uvc_drop_missed)
+			uvc_video_missed(video, req);
+		break;
+
 	case -ESHUTDOWN:	/* disconnect from host. */
+		/*
+		 * The endpoint is being disabled: no idle work (enabling the
+		 * stream again resets ep_idle).
+		 */
+		spin_unlock_irqrestore(&queue->irqlock, flags);
 		uvcg_dbg(&video->uvc->func, "VS request cancelled.\n");
 		uvcg_queue_cancel(queue, 1);
 		goto requeue;
 
 	default:
+		idle = video->in_flight == 0;
+		spin_unlock_irqrestore(&queue->irqlock, flags);
 		uvcg_warn(&video->uvc->func,
 			  "VS request completed with status %d.\n",
 			  req->status);
@@ -224,37 +502,34 @@
 		goto requeue;
 	}
 
-	spin_lock_irqsave(&video->queue.irqlock, flags);
-	buf = uvcg_queue_head(&video->queue);
-	if (buf == NULL) {
-		spin_unlock_irqrestore(&video->queue.irqlock, flags);
-		goto requeue;
-	}
-
-	video->encode(req, video, buf);
+	/*
+	 * Only continue a frame that is being sent (a frame larger than the
+	 * request pool): new frames are started on an idle endpoint, and
+	 * nothing is queued on a transfer that missed an interval.
+	 */
+	buf = uvcg_queue_head(queue);
+	if (!video->recover && buf &&
+	    (video->max_payload_size || queue->buf_used)) {
+		video->encode(req, video, buf);
 
-	ret = uvcg_video_ep_queue(video, req);
-	spin_unlock_irqrestore(&video->queue.irqlock, flags);
+		ret = uvcg_video_ep_queue(video, req);
+		idle = ret < 0 && video->in_flight == 0;
+		spin_unlock_irqrestore(&queue->irqlock, flags);
 
-	if (ret < 0) {
-		uvcg_queue_cancel(queue, 0);
-		goto requeue;
+		if (ret < 0) {
+			uvcg_queue_cancel(queue, 0);
+			goto requeue;
+		}
+		return;
 	}
 
-	return;
+	idle = video->in_flight == 0;
+	spin_unlock_irqrestore(&queue->irqlock, flags);
 
 requeue:
-	spin_lock_irqsave(&video->req_lock, flags);
-	/*
-	 * The video stream might have been disabled while we were processing
-	 * the current usb_request, so make sure we're still streaming before
-	 * putting it back on req_free.
-	 */
-	if (video->is_enabled)
-		list_add_tail(&req->list, &video->req_free);
-	else
-		uvc_video_free_request(req, ep);
-	spin_unlock_irqrestore(&video->req_lock, flags);
+	uvc_video_put_request(video, req);
+	if (idle)
+		queue_work(system_highpri_wq, &video->idle_work);
 }
 
