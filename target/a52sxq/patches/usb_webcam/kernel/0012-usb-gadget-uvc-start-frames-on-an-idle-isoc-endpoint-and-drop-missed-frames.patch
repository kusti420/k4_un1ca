  * Request handling
  */
 
+/* Called with video->queue.irqlock held. */
 static int uvcg_video_ep_queue(struct uvc_video *video, struct usb_request *req)
 {
 	int ret;
 
 	ret = usb_ep_queue(video->ep, req, GFP_ATOMIC);
+	if (ret == 0)
