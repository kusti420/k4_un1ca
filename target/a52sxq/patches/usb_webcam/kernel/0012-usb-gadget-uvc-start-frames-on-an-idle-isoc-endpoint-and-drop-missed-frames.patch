+ * missed isochronous interval is still completed normally (the host then
+ * receives it truncated, the behaviour before missed transfers were
+ * handled); the missed requests are only counted.
+ */
+static bool uvc_drop_missed = true;
+module_param_named(drop_missed, uvc_drop_missed, bool, 0644);
+MODULE_PARM_DESC(drop_missed, "Drop frames that lost a payload to a missed isochronous interval");
+
 /* --------------------------------------------------------------------------
  * Video codecs
  */
@@ -79,12 +102,14 @@
 
 	req->length = video->req_size - len;
