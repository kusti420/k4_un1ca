+// Reads .android_maps of either layout into md. obj: the object as opened by libbpf, or null (then
+// it is opened here for the v2 sizes). Returns 0, -2 when there is no .android_maps section, else -1.
+static int readMapDefs(const ElfObject& elfObj, struct bpf_object* obj, vector<struct bpf_map_def>& md) {
+    md.clear();
+    const int idx = elfObj.getSectionIdxByName(".android_maps");
+    if (idx < 0) return -2;
+    const Elf64_Shdr& s = elfObj.SH(idx);
+    if (!s.sh_size) return 0;
+    const long symSize = elfObj.getSectionSymSize(idx);
+    size_t recSize = 0;
+    if (symSize == (long)sizeof(struct bpf_map_def) || symSize == (long)sizeof(struct bpf_map_def_v2)) {
+        recSize = symSize;
+    } else if (symSize <= 0) {
+        // no usable symbols: let the section size decide, if it is unambiguous
+        const bool v1 = !(s.sh_size % sizeof(struct bpf_map_def));
+        const bool v2 = !(s.sh_size % sizeof(struct bpf_map_def_v2));
+        if (v1 != v2) recSize = v1 ? sizeof(struct bpf_map_def) : sizeof(struct bpf_map_def_v2);
+    }
+    if (!recSize || s.sh_size % recSize) {
+        ALOGE("%s: unknown struct bpf_map_def layout (symbol size %ld, section size %llu) - "
+              "this loader knows 192 (<= 26Q3) and 180 (26Q4) bytes", elfObj.path, symSize,
+              (unsigned long long)s.sh_size);
+        return -1;
+    }
+    if (recSize == sizeof(struct bpf_map_def)) {
+        auto v1 = elfObj.getSectionByIdx<struct bpf_map_def>(idx);
+        if (v1.empty()) return -1;
+        md.assign(v1.begin(), v1.end());
+        ALOGD("%s: %zu maps, struct bpf_map_def v1 (%zu bytes)", elfObj.path, md.size(), recSize);
+        return 0;
+    }
+    auto v2 = elfObj.getSectionByIdx<struct bpf_map_def_v2>(idx);
+    if (v2.empty()) return -1;
+    struct bpf_object* own = nullptr;
+    if (!obj) {
+        LIBBPF_OPTS(bpf_object_open_opts, opts,
+            .bpf_token_path = "",
+        );
+        own = bpf_object__open_file(elfObj.path, &opts);
+        if (!own) {
+            ALOGE("%s: bpf_object__open_file failed: %s", elfObj.path, strerror(errno));
+            return -1;
+        }
+        obj = own;
+    }
+    auto ownGuard = base::make_scope_guard([own] { if (own) bpf_object__close(own); });
+    for (const auto& d : v2) {
+        if (d.name_idx >= sizeof(d.pin_location)) {
+            ALOGE("%s: map def with name_idx %u out of range", elfObj.path, d.name_idx);
+            return -1;
+        }
+        struct bpf_map* bm = bpf_object__find_map_by_name(obj, d.name());
+        if (!bm) {
+            ALOGE("%s: map %s has no libbpf (.maps) definition", elfObj.path, d.name());
+            return -1;
+        }
+        struct bpf_map_def m = {};
+        m.type = d.type;
+        m.key_size = bpf_map__key_size(bm);
+        m.value_size = bpf_map__value_size(bm);
+        m.max_entries = bpf_map__max_entries(bm);
+        m.map_flags = d.map_flags;
+        m.uid = d.uid;
+        m.gid = d.gid;
+        m.mode = d.mode;
+        m.min_api_level_full = d.min_api_level_full;
+        m.max_api_level_full = d.max_api_level_full;
+        m.min_kver = d.min_kver;
+        m.max_kver = d.max_kver;
+        memcpy(m.create_location, d.create_location, sizeof(m.create_location));
+        memcpy(m.pin_location, d.pin_location, sizeof(m.pin_location));
+        m.name_idx = d.name_idx;
+        ALOGD("%s: v2 map %s: type %u key %u value %u entries %u flags %#x", elfObj.path, m.name(),
+              (unsigned)m.type, m.key_size, m.value_size, m.max_entries, m.map_flags);
+        md.push_back(m);
+    }
+    ALOGD("%s: %zu maps, struct bpf_map_def v2 (%zu bytes, sizes from libbpf)", elfObj.path, md.size(),
+          recSize);
+    return 0;
+}
