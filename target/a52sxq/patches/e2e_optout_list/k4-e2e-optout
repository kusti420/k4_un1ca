#!/system/bin/sh
# Force the packages listed in /system/etc/k4/force_opt_out_e2e.txt out of edge-to-edge enforcement (see module.prop).
# The list is kept by system_server in memory only, so this runs at every boot (k4_e2e_optout.rc).
LIST=/system/etc/k4/force_opt_out_e2e.txt
n=0
while IFS= read -r pkg; do
    pkg="${pkg%%#*}"; pkg="$(echo "$pkg" | tr -d ' \t\r')"
    [ -n "$pkg" ] || continue
    if cmd window force-opt-out-e2e-add "$pkg" > /dev/null 2>&1; then n=$((n + 1)); fi
done < "$LIST"
log -p i -t k4-e2e-optout "$n package(s) forced out of edge-to-edge"
