#!/system/bin/sh
# k4-tethering-gate - the runtime half of the Tethering train coverage guard (target/a52sxq/patches/tethering_trains).
# init runs it at load-bpf-programs on an update boot (apexd.packages.updated=true), after the evidence capture of
# a52sxq_mainline.rc and before netbpfload.rc starts the loader (k4_tethering_gate.rc sorts between them).
#
# Our loader is frozen: it only ever loads /system/etc/bpf/a52_netd.o. A Play Tethering whose own netd.o defines map
# pins a52_netd.o does not create makes that APEX's userspace abort at boot ("Cannot open ... map" in netd /
# system_server) -> crash loop -> RescueParty / Samsung bootchecker escalation -> apexd revert after several reboots
# (2026-10-10 evidence). Instead: compare the pin paths now and, on a gap, set sys.k4.tethering_gap; the rc then sets
# sys.init.updatable_crashing (what init sets when an `updatable` service died 4 times) and apexd's
# WaitForBootStatus reverts the staged session and reboots once, before anything crashes. Verdict only: it never
# fires when nothing is missing, when Tethering was not updated in this boot, or when an object cannot be read.
# Host test: tethering_trains/test/run.sh (K4TG_LIVE, K4TG_OURS, K4TG_UPDATED, K4TG_KMSG, K4TG_PROPFILE).
LIVE="${K4TG_LIVE:-/apex/com.android.tethering/etc/bpf/mainline/netd.o}"
OURS="${K4TG_OURS:-/system/etc/bpf/a52_netd.o}"
UPDATED="${K4TG_UPDATED:-/apex/apex-updated-list.xml}"
log() { echo "k4-tethering-gate: $*" 2> /dev/null > "${K4TG_KMSG:-/dev/kmsg}"; }
sp() { if [ -n "${K4TG_PROPFILE:-}" ]; then echo "$1=$2" >> "$K4TG_PROPFILE"; else setprop "$1" "$2"; fi; }
grep -q 'moduleName="com.android.tethering"' "$UPDATED" 2> /dev/null || { log "Tethering not updated in this boot"; exit 0; }
[ -r "$LIVE" ] && [ -r "$OURS" ] || { log "cannot read $LIVE or $OURS, no verdict"; exit 0; }
# map pin paths an object defines (/sys/fs/bpf/<dir>/map_<obj>_<name>), like k4-mainline-diag and check_netd.py
pins() { strings -n 8 "$1" 2> /dev/null | grep '^/sys/fs/bpf/[^/]*/map_' | sort -u; }
OP="$(pins "$OURS")"
LP="$(pins "$LIVE")"
[ -n "$OP" ] && [ -n "$LP" ] || { log "no map pin list from $OURS or $LIVE, no verdict"; exit 0; }
MISSING=""
for p in $LP; do printf '%s\n' "$OP" | grep -qx -- "$p" || MISSING="$MISSING ${p##*/map_}"; done
if [ -n "$MISSING" ]; then
    log "the updated Tethering defines BPF maps a52_netd.o does not create:$MISSING - asking apexd to revert this update (see k4-mainline-diag)"
    sp sys.k4.tethering_gap "$(echo $MISSING | cut -c 1-90)"
else
    log "updated Tethering: every map pin is in a52_netd.o"
fi
exit 0
